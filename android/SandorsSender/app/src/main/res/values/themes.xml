<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sandors" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/obsidian</item>
        <item name="android:statusBarColor">@color/obsidian</item>
        <item name="android:navigationBarColor">@color/obsidian</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorAccent">@color/red</item>
        <item name="colorPrimary">@color/red</item>
        <item name="android:textColor">@color/ink</item>
        <item name="buttonStyle">@style/Sandors.Button</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Sandors.Button" parent="Widget.AppCompat.Button">
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_button_red</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Sandors.Button.Ghost" parent="Sandors.Button">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/ink</item>
    </style>
</resources>
